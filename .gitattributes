# Normalize line endings across macOS and Windows
* text=auto

# Windows scripts must always check out with CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Unix / macOS shell scripts, web UI, and ExtendScript must keep LF
*.sh text eol=lf
*.command text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
